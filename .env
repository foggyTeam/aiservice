# AIService Environment Configuration

# Server Configuration
PORT=8080
ENV=dev
VERIFICATION_KEY=your_verification_key_here

# Database Configuration
# Options: memory, sqlite
DB_TYPE=memory

# SQLite Configuration (used when DB_TYPE=sqlite)
SQLITE_FILE_PATH=./aiservice.db

# LLM Provider Selection
# Options: ollama, gemini, yandex
# Can be overridden with --provider flag at runtime

# Ollama Configuration (default - local LLM)
OLLAMA_BASE_URL=http://ollama:11434

LLM_API_KEY=
LLM_PROVIDER=ollama
# LLM_MODEL=gemma3:12b
LLM_MODEL=deepseek-ocr:latest

# Model Configuration (provider-specific)
# Ollama: gemma3, llama3.2, mistral, etc.
# Gemini: googleai/gemini-2.5-flash, googleai/gemini-pro, etc.
# Yandex: yandexgpt-lite, yandexgpt, etc.

# Image Configuration
IMAGES_DIR=/app/images

# Job Configuration
JOB_QUEUE_SIZE=100
JOB_WORKERS=2
DB_JOB_WORKERS=1
JOB_MAX_RETRIES=3
JOB_RETRY_BACKOFF=2s

# Timeout Configuration
TIMEOUT_SYNC_PROCESS=20m
TIMEOUT_INK_RECOGNIZE=20m
TIMEOUT_LLM_REQUEST=20m

# Debug Configuration
DB_DEBUG=false
