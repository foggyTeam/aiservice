# AIService Environment Configuration

# Server Configuration
PORT=8080
ENV=dev
VERIFICATION_KEY=your_verification_key_here

# Database Configuration
# Options: memory, sqlite
DB_TYPE=memory

# SQLite Configuration (used when DB_TYPE=sqlite)
SQLITE_FILE_PATH=./aiservice.db

# LLM Provider Selection
# Options: ollama, gemini, yandex
# Can be overridden with --provider flag at runtime
LLM_PROVIDER=ollama
# LLM_PROVIDER=gemini

# Text Model Configuration (для суммаризации)
LLM_TEXT_MODEL=gemma3:12b
# LLM_TEXT_MODEL=googleai/gemini-2.5-flash

# Vision Model Configuration (для распознавания изображений)
LLM_VISION_MODEL=gemma3:12b
# LLM_VISION_MODEL=googleai/gemini-2.5-flash

# Ollama Configuration (default - local LLM)
OLLAMA_BASE_URL=http://ollama:11434

# Gemini Configuration
LLM_API_KEY=
# GEMINI_API_KEY=
# GEMINI_BASE_URL=

# Model Configuration (provider-specific)
# Ollama Text Models: gemma3:4b, llama3.2:3b, mistral:7b
# Ollama Vision Models: gemma3:12b, llava:7b, llava-llama3:8b, minicpm-v:8b
# Gemini: googleai/gemini-2.5-flash, googleai/gemini-pro, etc.

# Image Configuration
IMAGES_DIR=/app/images

# Job Configuration
JOB_QUEUE_SIZE=100
JOB_WORKERS=10
DB_JOB_WORKERS=2
JOB_MAX_RETRIES=3
JOB_RETRY_BACKOFF=2s

# Timeout Configuration
TIMEOUT_SYNC_PROCESS=20m
TIMEOUT_INK_RECOGNIZE=20m
TIMEOUT_LLM_REQUEST=20m

# Debug Configuration
DB_DEBUG=false
