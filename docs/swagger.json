                },
                "requestType": {
                    "type": "string"
                },
                "structurizeRequest": {
                    "$ref": "#/definitions/models.StructurizeRequest"
                },
                "summarizeRequest": {
                    "$ref": "#/definitions/models.SummarizeRequest"
                },
                "templateRequest": {
                    "$ref": "#/definitions/models.GenerateTemplateRequest"
                }
            }
        },
